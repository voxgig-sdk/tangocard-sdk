      name: "list"
      points: [
        {
          co: {
            id: "GET /choiceProducts"
            source: "openapi3"
            version: 2
          }
          g: {
            query: [
              {
                k: "query"
                n: "country"
                or: "country"
                r: false
                t: "`$ARRAY`"
              }
              {
                k: "query"
                n: "currency_code"
                or: "currency_code"
                r: false
                t: "`$STRING`"
              }
              {
                k: "query"
                n: "reward_name"
                or: "reward_name"
                r: false
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/choiceProducts"
          q: {
            exist: [
              "country"
              "currency_code"
              "reward_name"
            ]
          }
          s: [
            {
              lit: "choiceProducts"
            }
          ]
          t: {
            req: "`reqdata`"
            res: "`body.choiceProducts`"
          }
        }
      ]
    }
    load: {
      name: "load"
      points: [
        {
          co: {
            id: "GET /choiceProducts/{utid}"
