          }
          g: {
            params: [
              {
                k: "param"
                n: "id"
                or: "utid"
                r: true
                t: "`$STRING`"
              }
            ]
          }
          m: "GET"
          o: "/choiceProducts/{utid}"
          q: {
            exist: [
              "id"
            ]
          }
          r: {
            param: {
              utid: "id"
            }
          }
          s: [
            {
              lit: "choiceProducts"
            }
            {
              var: "id"
            }
          ]
          t: {
