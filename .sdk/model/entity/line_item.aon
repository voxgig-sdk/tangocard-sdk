          contract: {
            id: "GET /lineItems"
            json: "{\"operationId\":\"listLineItems\",\"parameters\":[{\"description\":\"Specify the reference order ID to be queried.\",\"in\":\"query\",\"name\":\"referenceOrderID\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the external reference order ID to be queried.\",\"in\":\"query\",\"name\":\"externalRefID\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The unique identifier for the reward as provided in the Get Catalog call\",\"in\":\"query\",\"name\":\"utid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The unique identifier for the Print Reward Link Template provided in the Tango Portal on the Printed Template page. Only applicable when sending a Printed Reward Link.\",\"in\":\"query\",\"name\":\"ptid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"The unique identifier for the electronic template. Only applicable when deliveryMethod is EMAIL or PHONE\",\"in\":\"query\",\"name\":\"etid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the line item status to be queried.\",\"in\":\"query\",\"name\":\"status\",\"required\":false,\"schema\":{\"enum\":[\"COMPLETE\",\"PENDING\",\"FAILED\",\"CANCELLED\"],\"type\":\"string\"}},{\"description\":\"Specify the email status to be queried.\",\"in\":\"query\",\"name\":\"emailStatus\",\"required\":false,\"schema\":{\"enum\":[\"DELIVERED\",\"NOT_DELIVERED\",\"PENDING\",\"SENT\",\"DEFERRED\",\"DROPPED\",\"BOUNCE\",\"BLOCKED\"],\"type\":\"string\"}},{\"description\":\"Specify the delivery method to be queried.\",\"in\":\"query\",\"name\":\"deliveryMethod\",\"required\":false,\"schema\":{\"enum\":[\"NONE\",\"EMAIL\",\"PHONE\",\"ADDRESS\",\"EMBEDDED\",\"BULKSHIPMENT\",\"QRCODE\",\"BULKDIGITAL\",\"EMBEDDED_COMPONENT\",\"WHATSAPP\"],\"type\":\"string\"}},{\"description\":\"Specify the delivery status to be queried.\",\"in\":\"query\",\"name\":\"deliveryStatus\",\"required\":false,\"schema\":{\"enum\":[\"PENDING\",\"PROCESSING\",\"DISPATCHED\",\"DELIVERED\",\"FAILED\",\"ENGAGED\"],\"type\":\"string\"}},{\"description\":\"Specify the order status to be queried.\",\"in\":\"query\",\"name\":\"orderStatus\",\"required\":false,\"schema\":{\"enum\":[\"COMPLETE\",\"PENDING\",\"FAILED\",\"CANCELLED\",\"PARTIAL\"],\"type\":\"string\"}},{\"description\":\"Specify the order source to be queried.\",\"in\":\"query\",\"name\":\"orderSource\",\"required\":false,\"schema\":{\"enum\":[\"RA\",\"RG\",\"BE\",\"BI\",\"CI\",\"QW\",\"AA\"],\"type\":\"string\"}},{\"description\":\"Specify the recipient email address to be queried.\",\"in\":\"query\",\"name\":\"recipientEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipient mobile number to be queried.\",\"in\":\"query\",\"name\":\"recipientMobileNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipient first name to be queried.\",\"in\":\"query\",\"name\":\"recipientFirstName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipient last name to be queried.\",\"in\":\"query\",\"name\":\"recipientLastName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the account identifier to be queried.\",\"in\":\"query\",\"name\":\"accountIdentifier\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the campaign to be queried.\",\"in\":\"query\",\"name\":\"campaign\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the purchaseOrderNumber to be queried.\",\"in\":\"query\",\"name\":\"purchaseOrderNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the orderNotes to be queried.\",\"in\":\"query\",\"name\":\"orderNotes\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientStreetLine1 to be queried.\",\"in\":\"query\",\"name\":\"recipientStreetLine1\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientStreetLine2 to be queried.\",\"in\":\"query\",\"name\":\"recipientStreetLine2\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientCity to be queried.\",\"in\":\"query\",\"name\":\"recipientCity\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientStateOrProvince to be queried.\",\"in\":\"query\",\"name\":\"recipientStateOrProvince\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientPostalCode to be queried.\",\"in\":\"query\",\"name\":\"recipientPostalCode\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the recipientCountry to be queried.\",\"in\":\"query\",\"name\":\"recipientCountry\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the starting date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"startDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the ending date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"endDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"Specify the column name to sort by.\",\"in\":\"query\",\"name\":\"columnSortName\",\"required\":false,\"schema\":{\"default\":\"dateIssued\",\"enum\":[\"accountNumber\",\"amountIssued\",\"dateIssued\",\"emailStatus\",\"deliveryMethod\",\"externalReferenceId\",\"status\",\"orderSource\",\"orderStatus\",\"recipientFirstName\",\"recipientLastName\",\"rewardName\"],\"type\":\"string\"}},{\"description\":\"Specify the sorting line-items ascending.\",\"in\":\"query\",\"name\":\"columnSortAscending\",\"required\":false,\"schema\":{\"default\":\"false\",\"type\":\"string\"}},{\"description\":\"Specify the number of elements in a block.\",\"in\":\"query\",\"name\":\"elementsPerBlock\",\"required\":false,\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"Return the previous page instead of the next page.\",\"in\":\"query\",\"name\":\"pagePrevious\",\"required\":false,\"schema\":{\"default\":false,\"type\":\"boolean\"}},{\"description\":\"Specify the page keys to query the next page.\",\"in\":\"query\",\"name\":\"pageKeys\",\"required\":false,\"schema\":{\"items\":{\"type\":\"string\"},\"type\":\"array\"}},{\"description\":\"Specify the minimum remaining balance to be queried.\",\"in\":\"query\",\"name\":\"minRemainingBalance\",\"required\":false,\"schema\":{\"type\":\"number\"}},{\"description\":\"Specify the maximum remaining balance to be queried.\",\"in\":\"query\",\"name\":\"maxRemainingBalance\",\"required\":false,\"schema\":{\"type\":\"number\"}},{\"description\":\"If true, return any line item that has a remaining balance.\",\"in\":\"query\",\"name\":\"hasRemainingBalance\",\"required\":false,\"schema\":{\"type\":\"boolean\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"keysetPage\":{\"properties\":{\"nextPageKeys\":{\"items\":{\"type\":\"string\"},\"title\":\"Keys to get next page\",\"type\":\"array\"},\"previousPageKeys\":{\"items\":{\"type\":\"string\"},\"title\":\"Keys to get previous page\",\"type\":\"array\"},\"resultCount\":{\"format\":\"int32\",\"title\":\"Total number of elements in the current page\",\"type\":\"integer\"},\"totalCount\":{\"format\":\"int64\",\"title\":\"Total number of elements\",\"type\":\"integer\"}},\"required\":[\"nextPageKeys\",\"previousPageKeys\",\"resultCount\",\"totalCount\"],\"title\":\"Keyset (seek) page data for matching line items\",\"type\":\"object\"},\"lineItems\":{\"items\":{\"properties\":{\"accountIdentifier\":{\"title\":\"Account Identifier\",\"type\":\"string\"},\"accountNumber\":{\"title\":\"Account Number\",\"type\":\"string\"},\"amountCharged\":{\"properties\":{\"currencyCode\":{\"type\":\"string\"},\"exchangeRate\":{\"type\":\"number\"},\"fee\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"value\":{\"type\":\"number\"}},\"title\":\"Amount Charged\",\"type\":\"object\"},\"amountIssued\":{\"properties\":{\"currencyCode\":{\"type\":\"string\"},\"exchangeRate\":{\"type\":\"number\"},\"fee\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"value\":{\"type\":\"number\"}},\"title\":\"Amount Issued\",\"type\":\"object\"},\"campaign\":{\"title\":\"Campaign\",\"type\":\"string\"},\"canCancel\":{\"title\":\"Can Cancel\",\"type\":\"boolean\"},\"canFreeze\":{\"title\":\"Can Freeze\",\"type\":\"boolean\"},\"customerIdentifier\":{\"title\":\"Customer Identifier\",\"type\":\"string\"},\"dateIssued\":{\"format\":\"date-time\",\"title\":\"Date Issued\",\"type\":\"string\"},\"deliveryMethod\":{\"title\":\"Delivery Method\",\"type\":\"string\"},\"deliveryStatus\":{\"title\":\"Delivery Status\",\"type\":\"string\"},\"emailStatus\":{\"title\":\"Email Status\",\"type\":\"string\"},\"etid\":{\"title\":\"Etid\",\"type\":\"string\"},\"expirationDate\":{\"format\":\"date-time\",\"title\":\"Expiration Date\",\"type\":\"string\"},\"externalReferenceLineItemID\":{\"title\":\"External Reference Line Item ID\",\"type\":\"string\"},\"lineItemActionReason\":{\"title\":\"Line Item Action Reason\",\"type\":\"string\"},\"lineItemErrors\":{\"description\":\"Errors related to the line item\",\"items\":{\"properties\":{\"error_code\":{\"type\":\"string\"},\"error_message\":{\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Line Item Errors\",\"type\":\"array\"},\"lineNumber\":{\"format\":\"int32\",\"title\":\"Line Number\",\"type\":\"integer\"},\"orderNotes\":{\"title\":\"Order Notes\",\"type\":\"string\"},\"orderSource\":{\"title\":\"Order Source\",\"type\":\"string\"},\"orderStatus\":{\"title\":\"Order Status\",\"type\":\"string\"},\"ptid\":{\"title\":\"Ptid\",\"type\":\"string\"},\"purchaseOrderNumber\":{\"title\":\"Purchase Order Number\",\"type\":\"string\"},\"quantity\":{\"description\":\"quantity of line items\",\"format\":\"int32\",\"title\":\"quantity\",\"type\":\"integer\"},\"recipient\":{\"properties\":{\"address\":{\"properties\":{\"city\":{\"title\":\"City\",\"type\":\"string\"},\"companyName\":{\"title\":\"Company Name\",\"type\":\"string\"},\"country\":{\"title\":\"Country Code\",\"type\":\"string\"},\"postalCode\":{\"title\":\"Postal Code\",\"type\":\"string\"},\"stateOrProvince\":{\"title\":\"State or Province\",\"type\":\"string\"},\"streetLine1\":{\"title\":\"Street Line 1\",\"type\":\"string\"},\"streetLine2\":{\"title\":\"Street Line 2\",\"type\":\"string\"}},\"title\":\"Address\",\"type\":\"object\"},\"email\":{\"title\":\"Email\",\"type\":\"string\"},\"firstName\":{\"title\":\"First Name\",\"type\":\"string\"},\"lastName\":{\"title\":\"Last Name\",\"type\":\"string\"},\"mobileNumber\":{\"title\":\"Mobile Number\",\"type\":\"string\"}},\"title\":\"Recipient Details\",\"type\":\"object\"},\"referenceLineItemID\":{\"title\":\"Reference Line Item ID\",\"type\":\"string\"},\"referenceOrderID\":{\"title\":\"Reference Order ID\",\"type\":\"string\"},\"reissuedFromReferenceLineItemId\":{\"description\":\"Reissued from reference line item ID\",\"title\":\"Reissued From\",\"type\":\"string\"},\"reissuedToReferenceLineItemId\":{\"description\":\"Reissued to reference line item ID\",\"title\":\"Reissued To\",\"type\":\"string\"},\"remainingBalance\":{\"title\":\"Remaining Balance\",\"type\":\"number\"},\"rewardName\":{\"title\":\"Reward Name\",\"type\":\"string\"},\"rewardStatus\":{\"title\":\"Reward Status\",\"type\":\"string\"},\"sender\":{\"properties\":{\"email\":{\"title\":\"Email\",\"type\":\"string\"},\"firstName\":{\"title\":\"First Name\",\"type\":\"string\"},\"lastName\":{\"title\":\"Last Name\",\"type\":\"string\"}},\