    name: {
      h: "Name"
      n: "name"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "A unique name to give the template."
      t: "`$STRING`"
    }
    smsMessageBody: {
      h: "Sms Message Body"
      n: "smsMessageBody"
      r: false
      sh: "The message body for the SMS."
      t: "`$STRING`"
    }
    subject: {
      h: "Subject"
      n: "subject"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
