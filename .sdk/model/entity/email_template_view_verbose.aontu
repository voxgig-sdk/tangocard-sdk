    }
    customerServiceMessage: {
      h: "Customer Service Message"
      n: "customerServiceMessage"
      r: false
      sh: "If left null, Tango Card's Customer Support contact information will be included."
      t: "`$STRING`"
    }
    defaults: {
      h: "Defaults"
      n: "defaults"
