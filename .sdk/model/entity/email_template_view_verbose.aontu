        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "The name that will appear in the From line of the email and the {from_name} in the text message."
      t: "`$STRING`"
    }
    headerImage: {
      h: "Header Image"
      n: "headerImage"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "A Base64 encoded string of an image that will show as the header of the email."
      t: "`$STRING`"
    }
    headerImageAltText: {
      h: "Header Image Alt Text"
      n: "headerImageAltText"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
