# Entity: email_template_view_verbose

main: kit: entity: email_template_view_verbose: {

  alias: field: {}

  fields: {
    accentColor: {
      h: "Accent Color"
      n: "accentColor"
      op: {
        update: {
          req: false
          type: "`$STRING`"
        }
      }
      r: true
      sh: "A Hex color value, six hexadecimal digits preceded by a pound sign, used as an accent in the email."
      t: "`$STRING`"
    }
    accessControl: {
      h: "Access Control"
      n: "accessControl"
