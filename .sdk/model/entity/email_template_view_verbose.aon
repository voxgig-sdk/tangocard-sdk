          contract: {
            id: "GET /digitalTemplates"
            json: "{\"operationId\":\"listDigitalTemplates\",\"parameters\":[{\"description\":\"specify the number of elements in a block.\",\"in\":\"query\",\"name\":\"elementsPerBlock\",\"required\":false,\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"specify the page number to return.\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"emailTemplates\":{\"items\":{\"properties\":{\"accentColor\":{\"title\":\"Accent Color\",\"type\":\"string\"},\"accessControls\":{\"items\":{\"properties\":{\"identifier\":{\"description\":\"Leave this field blank if the type is PLATFORM.  Enter either the the customerIdentifier or the accountIdentifier if the type is CUSTOMER OR ACCOUNT, respectively.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of access being specified: PLATFORM, CUSTOMER or ACCOUNT.\",\"enum\":[\"PLATFORM\",\"CUSTOMER\",\"ACCOUNT\"],\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Access Control\",\"type\":\"array\"},\"closing\":{\"title\":\"Closing Message\",\"type\":\"string\"},\"customerServiceMessage\":{\"title\":\"Customer Service Message\",\"type\":\"string\"},\"defaults\":{\"items\":{\"properties\":{\"identifier\":{\"description\":\"Leave this field blank if the type is PLATFORM.  Enter either the the customerIdentifier or the accountIdentifier if the type is CUSTOMER OR ACCOUNT, respectively.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of default being specified: PLATFORM, CUSTOMER or ACCOUNT.\",\"enum\":[\"PLATFORM\",\"CUSTOMER\",\"ACCOUNT\"],\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Defaults\",\"type\":\"array\"},\"etid\":{\"title\":\"Email Template Identifier (ETID)\",\"type\":\"string\"},\"fromName\":{\"title\":\"From Name\",\"type\":\"string\"},\"headerImage\":{\"title\":\"Header Image Url\",\"type\":\"string\"},\"headerImageAltText\":{\"title\":\"Header Image - Alt Text\",\"type\":\"string\"},\"messageBody\":{\"title\":\"Message Body\",\"type\":\"string\"},\"name\":{\"title\":\"Name\",\"type\":\"string\"},\"smsMessageBody\":{\"title\":\"SMS Message Body\",\"type\":\"string\"},\"subject\":{\"title\":\"Subject\",\"type\":\"string\"}},\"required\":[\"accentColor\",\"closing\",\"etid\",\"fromName\",\"headerImage\",\"headerImageAltText\",\"messageBody\",\"name\",\"subject\"],\"type\":\"object\"},\"title\":\"Email Template elements for the current page\",\"type\":\"array\"},\"page\":{\"properties\":{\"elementsPerBlock\":{\"format\":\"int32\",\"title\":\"Total number of elements per page\",\"type\":\"integer\"},\"number\":{\"format\":\"int32\",\"title\":\"Current page number\",\"type\":\"integer\"},\"resultCount\":{\"format\":\"int32\",\"title\":\"Total number of elements in the current page\",\"type\":\"integer\"},\"totalCount\":{\"format\":\"int64\",\"title\":\"Total number of elements\",\"type\":\"integer\"}},\"required\":[\"elementsPerBlock\",\"number\",\"resultCount\",\"totalCount\"],\"title\":\"Page data for email templates\",\"type\":\"object\"}},\"required\":[\"emailTemplates\",\"page\"],\"type\":\"object\"}}},\"description\":\"OK\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{},\"type\":\"array\"},\"httpCode\":{\"format\":\"int32\",\"type\":\"integer\"},\"httpPhrase\":{\"type\":\"string\"},\"i18nKey\":{\"type\":\"string\"},\"message\":{\"description\":\"A Generic Example \",\"example\":\"The error message will show here for error codes\",\"title\":\"message\",\"type\":\"string\"},\"path\":{\"type\":\"string\"},\"requestId\":{\"type\":\"string\"},\"timestamp\":{\"format\":\"date-time\",\"type\":\"string\"}},\"type\":\"object\"}}},\"description\":\"Bad Request\"},\"401\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"type\":\"object\"}}},\"description\":\"Unauthorized\"},\"403\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"type\":\"object\"}}},\"description\":\"Forbidden\"},\"500\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"type\":\"object\"}}},\"description\":\"Internal Server Error\"},\"503\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"$ref\":\"#/responses/400/content/application~1json/schema/properties\"},\"type\":\"object\"}}},\"description\":\"Service Unavailable\"}},\"security\":[{\"basicAuth\":[]},{\"bearerToken\":[]}],\"securitySchemes\":{\"basicAuth\":{\"scheme\":\"basic\",\"type\":\"http\"},\"bearerToken\":{\"bearerFormat\":\"JWT\",\"scheme\":\"bearer\",\"type\":\"http\"}},\"securitySource\":\"definition\"}"
