          }
          contract: {
            id: "GET /digitalTemplates/{etid}"
            json: "{\"operationId\":\"getDigitalTemplate\",\"parameters\":[{\"description\":\"Template ID (ETID) is returned in the digital template response payload payload\",\"in\":\"path\",\"name\":\"etid\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"accentColor\":{\"title\":\"Accent Color\",\"type\":\"string\"},\"accessControls\":{\"items\":{\"properties\":{\"identifier\":{\"description\":\"Leave this field blank if the type is PLATFORM.  Enter either the the customerIdentifier or the accountIdentifier if the type is CUSTOMER OR ACCOUNT, respectively.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of access being specified: PLATFORM, CUSTOMER or ACCOUNT.\",\"enum\":[\"PLATFORM\",\"CUSTOMER\",\"ACCOUNT\"],\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Access Control\",\"type\":\"array\"},\"closing\":{\"title\":\"Closing Message\",\"type\":\"string\"},\"customerServiceMessage\":{\"title\":\"Customer Service Message\",\"type\":\"string\"},\"defaults\":{\"items\":{\"properties\":{\"identifier\":{\"description\":\"Leave this field blank if the type is PLATFORM.  Enter either the the customerIdentifier or the accountIdentifier if the type is CUSTOMER OR ACCOUNT, respectively.\",\"type\":\"string\"},\"type\":{\"description\":\"The type of default being specified: PLATFORM, CUSTOMER or ACCOUNT.\",\"enum\":[\"PLATFORM\",\"CUSTOMER\",\"ACCOUNT\"],\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Defaults\",\"type\":\"array\"},\"etid\":{\"title\":\"Email Template Identifier (ETID)\",\"type\":\"string\"},\"fromName\":{\"title\":\"From Name\",\"type\":\"string\"},\"headerImage\":{\"title\":\"Header Image Url\",\"type\":\"string\"},\"headerImageAltText\":{\"title\":\"Header Image - Alt Text\",\"type\":\"string\"},\"messageBody\":{\"title\":\"Message Body\",\"type\":\"string\"},\"name\":{\"title\":\"Name\",\"type\":\"string\"},\"smsM