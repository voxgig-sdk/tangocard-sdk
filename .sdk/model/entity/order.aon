            json: "{\"operationId\":\"getOrder\",\"parameters\":[{\"description\":\"Reference order ID is returned in the order response payload\",\"in\":\"path\",\"name\":\"referenceOrderID\",\"required\":true,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"accountIdentifier\":{\"title\":\"Account Identifier\",\"type\":\"string\"},\"accountNumber\":{\"title\":\"Account Number\",\"type\":\"string\"},\"amountCharged\":{\"properties\":{\"currencyCode\":{\"type\":\"string\"},\"exchangeRate\":{\"type\":\"number\"},\"fee\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"value\":{\"type\":\"number\"}},\"title\":\"Amount Charged\",\"type\":\"object\"},\"asyncOrderEntity\":{\"properties\":{\"createdAt\":{\"format\":\"date-time\",\"type\":\"string\"},\"duplicateLineItemRefIds\":{\"additionalProperties\":{\"format\":\"int32\",\"type\":\"integer\"},\"description\":\"If any duplicate duplicateLineItemRefIds exist in the request\",\"title\":\"Duplicate line item ref ids\",\"type\":\"object\"},\"externalRefID\":{\"description\":\"Required. Idempotent field that can be used for client-side order cross reference and prevent accidental order duplication. Will be returned in order response.\",\"title\":\"External Reference ID\",\"type\":\"string\"},\"failedLineItems\":{\"description\":\"Failed line items list (business validations)\",\"items\":{\"properties\":{\"errors\":{\"items\":{\"properties\":{\"errorCodeName\":{\"type\":\"string\"},\"errorCodeValue\":{\"format\":\"int32\",\"type\":\"integer\"},\"field\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"externalRefLineItemID\":{\"type\":\"string\"},\"lineItemId\":{\"type\":\"string\"},\"utid\":{\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Failed line items\",\"type\":\"array\"},\"status\":{\"description\":\"This status reflects about cart status or validation status