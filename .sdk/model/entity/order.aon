      short: "Optional."
      type: "`$STRING`"
    }
    {
      name: "etid"
      op: {
        create: {
          req: false
          type: "`$STRING`"
        }
      }
      req: true
      short: "Optional."
      type: "`$STRING`"
    }
    {
      name: "expirationDate"
