          contract: {
            id: "GET /orders"
            json: "{\"operationId\":\"listOrders\",\"parameters\":[{\"description\":\"specify the account to be queried.\",\"in\":\"query\",\"name\":\"accountIdentifier\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the customer to be queried\",\"in\":\"query\",\"name\":\"customerIdentifier\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the external reference ID to be queried\",\"in\":\"query\",\"name\":\"externalRefID\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the starting date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"startDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the ending date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"endDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the number of elements in a block.\",\"in\":\"query\",\"name\":\"elementsPerBlock\",\"required\":false,\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"specify the page number to return.\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"format\":\"int32\",\"type\":\"integer\"}},{\"description\":\"specify the minimum face value of the reward to be queried.\",\"in\":\"query\",\"name\":\"minAmount\",\"required\":false,\"schema\":{\"type\":\"number\"}},{\"description\":\"specify the maximum face value of the reward to be queried.\",\"in\":\"query\",\"name\":\"maxAmount\",\"required\":false,\"schema\":{\"type\":\"number\"}},{\"description\":\"specify the currency code of the reward to be queried.\",\"in\":\"query\",\"name\":\"currencyCode\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the unique identifier of the reward to be queried.\",\"in\":\"query\",\"name\":\"utid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the unique identifier of the physical delivery template to be queried.\",\"in\":\"query\",\"name\":\"ptid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the reward name of the reward to be queried.\",\"in\":\"query\",\"name\":\"rewardName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender's first name to be queried.\",\"in\":\"query\",\"name\":\"senderFirstName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender's last name to be queried.\",\"in\":\"query\",\"name\":\"senderLastName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender email address to be queried.\",\"in\":\"query\",\"name\":\"senderEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's email address to be queried.\",\"in\":\"query\",\"name\":\"recipientEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's mobile number to be queried.\",\"in\":\"query\",\"name\":\"recipientMobileNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's first name to be queried.\",\"in\":\"query\",\"name\":\"recipientFirstName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's last name to be queried.\",\"in\":\"query\",\"name\":\"recipientLastName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"deprecated\":true,\"description\":\"specify if sendEmail is true or false to be queried.\",\"in\":\"query\",\"name\":\"sendEmail\",\"required\":false,\"schema\":{\"type\":\"boolean\"}},{\"description\":\"specify the delivery method to be queried.\",\"in\":\"query\",\"name\":\"deliveryMethod\",\"required\":false,\"schema\":{\"enum\":[\"NONE\",\"EMAIL\",\"PHONE\",\"ADDRESS\",\"EMBEDDED\",\"BULKSHIPMENT\",\"QRCODE\",\"BULKDIGITAL\",\"EMBEDDED_COMPONENT\",\"WHATSAPP\"],\"type\":\"string\"}},{\"deprecated\":true,\"description\":\"specify the status to be queried.\",\"in\":\"query\",\"name\":\"status\",\"required\":false,\"schema\":{\"enum\":[\"PENDING\",\"QUEUED\",\"PENDING_MR\",\"ON_HOLD\",\"CANCELLED\",\"COMPLETE\",\"FAILED\",\"PARTIAL\",\"DELETED\",\"PENDING_KYB\",\"PENDING_PAYMENT\"],\"type\":\"string\"}},{\"description\":\"specify the order status to be queried.\",\"in\":\"query\",\"name\":\"orderStatus\",\"required\":false,\"schema\":{\"enum\":[\"PENDING\",\"QUEUED\",\"PENDING_MR\",\"ON_HOLD\",\"CANCELLED\",\"COMPLETE\",\"FAILED\",\"PARTIAL\",\"DELETED\",\"PENDING_KYB\",\"PENDING_PAYMENT\"],\"type\":\"string\"}},{\"description\":\"specify the line item status to be queried.\",\"in\":\"query\",\"name\":\"lineItemStatus\",\"required\":false,\"schema\":{\"enum\":[\"COMPLETE\",\"PENDING\",\"FAILED\",\"DELETED\",\"CANCELLED\",\"RETURNED\"],\"type\":\"string\"}},{\"description\":\"specify the campaign to be queried.\",\"in\":\"query\",\"name\":\"campaign\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the notes to be queried.\",\"in\":\"query\",\"name\":\"notes\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the notes to be queried.\",\"in\":\"query\",\"name\":\"lineItemNotes\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the purchaseOrderNumber to be queried.\",\"in\":\"query\",\"name\":\"purchaseOrderNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"orders\":{\"items\":{\"properties\":{\"accountIdentifier\":{\"title\":\"Account Identifier\",\"type\":\"string\"},\"accountNumber\":{\"title\":\"Account Number\",\"type\":\"string\"},\"amountCharged\":{\"properties\":{\"currencyCode\":{\"type\":\"string\"},\"exchangeRate\":{\"type\":\"number\"},\"fee\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"value\":{\"type\":\"number\"}},\"title\":\"Amount Charged\",\"type\":\"object\"},\"asyncOrderEntity\":{\"properties\":{\"createdAt\":{\"format\":\"date-time\",\"type\":\"string\"},\"duplicateLineItemRefIds\":{\"additionalProperties\":{\"format\":\"int32\",\"type\":\"integer\"},\"description\":\"If any duplicate duplicateLineItemRefIds exist in the request\",\"title\":\"Duplicate line item ref ids\",\"type\":\"object\"},\"externalRefID\":{\"description\":\"Required. Idempotent field that can be used for client-side order cross reference and prevent accidental order duplication. Will be returned in order response.\",\"title\":\"External Reference ID\",\"type\":\"string\"},\"failedLineItems\":{\"description\":\"Failed line items list (business validations)\",\"items\":{\"properties\":{\"errors\":{\"items\":{\"properties\":{\"errorCodeName\":{\"type\":\"string\"},\"errorCodeValue\":{\"format\":\"int32\",\"type\":\"integer\"},\"field\":{\"type\":\"string\"},\"message\":{\"type\":\"string\"}},\"type\":\"object\"},\"type\":\"array\"},\"externalRefLineItemID\":{\"type\":\"string\"},\"lineItemId\":{\"type\":\"string\"},\"utid\":{\"type\":\"string\"}},\"type\":\"object\"},\"title\":\"Failed line items\",\"type\":\"array\"},\"status\":{\"description\":\"This status reflects about cart status or validation status based on the processing\",\"title\":\"Order status\",\"type\":\"string\"},\"totalLineItems\":{\"description\":\"Total number of line items submitted in the request\",\"format\":\"int32\",\"title\":\"Total number of line items submitted\",\"type\":\"integer\"}},\"title\":\"Async order entity\",\"type\":\"object\"},\"campaign\":{\"title\":\"Reward Campaign\",\"type\":\"string\"},\"createdAt\":{\"title\":\"Created Date\",\"type\":\"string\"},\"customerIdentifier\":{\"title\":\"Customer Identifier\",\"type\":\"string\"},\"deliveryMethod\":{\"enum\":[\"NONE\",\"EMAIL\",\"PHONE\",\"ADDRESS\",\"EMBEDDED\",\"BULKSHIPMENT\",\"QRCODE\",\"BULKDIGITAL\",\"EMBEDDED_COMPONENT\",\"WHATSAPP\"],\"title\":\"Delivery Method\",\"type\":\"string\"},\"denomination\":{\"properties\":{\"currencyCode\":{\"type\":\"string\"},\"exchangeRate\":{\"type\":\"number\"},\"fee\":{\"type\":\"number\"},\"total\":{\"type\":\"number\"},\"value\":{\"type\":\"number\"}},\"title\":\"Denomination\",\"type\":\"object\"},\"emailSubject\":{\"title\":\"Email Subject\",\"type\":\"string\"},\"etid\":{\"title\":\"Reward Email Template\",\"type\":\"string\"},\"externalRefID\":{\"title\":\"External Reference ID\",\"type\":\"string\"},\"lineItemStatus\":{\"title\":\"Line Item Status\",\"type\":\"string\"},\"message\":{\"title\":\"Email Message\",\"type\":\"string\"},\"notes\":{\"title\":\"Notes\",\"type\":\"string\"},\"orderClientSource\":{\"title\":\"Order Client Source\",\"type\":\"string\"},\"orderExternalRefIdDupe\":{\"title\":\"Order External Ref Id Dupe\",\"type\":\"boolean\"},\"orderStatus\":{\"title\":\"Order Status\",\"type\":\"string\"},\"ptid\":{\"title\":\"Physical Reward Template Identifier\",\"type\":\"string\"},\"purchaseOrderNumber\":{\"title\":\"Purchase Order Number\",\"type\":\"string\"},\"recipient\":{\"properties\":{\"address\":{\"properties\":{\"city\":{\"title\":\"City\",\"type\":\"string\"},\"companyName\":{\"title\":\"Company Name\",\"type\":\"string\"},\"country\":{\"title\":\"Country Code\",\"type\":\"string\"},\"postalCode\":{\"title\":\"Postal Code\",\"type\":\"string\"},\"stateOrProvince\":{\"title\":\"State or Province\",\"type\":\"string\"},\"streetLine1\":{\"title\":\"Street Line 1\",\"type\":\"string\"},\"streetLine2\":{\"title\":\"Street Line 2\",\"type\":\"string\"}},\"title\":\"Address\",\"type\":\"object\"},\"email\":{\"title\":\"Email\",\"type\":\"string\"},\"firstName\":{\"title\":\"First Name\",\"type\":\"string\"},\"lastName\":{\"title\":\"Last Name\",\"type\":\"string\"},\"mobileNumber\":{\"title\":\"Mobile Number\",\"type\":\"string\"}},\"title\":\"Recipient Details\",\"type\":\"object\"},\"referenceOrderID\":{\"title\":\"Reference Order ID\",\"type\":\"string\"},\"rewardName\":{\"title\":\"Reward Name\",\"type\":\"string\"},\"sendEmail\":{\"deprecated\":true,\"title\":\"Send Email?\",\"type\":\"boolean\"},\"sender\":{\"properties\":{\"email\":{\"title\":\"Email\",\"type\":\"string\"},\"firstName\":{\"title\":\"First Name\",\"type\":\"string\"},\"lastName\":{\"title\":\"Last Name\",\"type\":\"string\"}},\"title\":\"Sender Details\",\"type\":\"object\"},\"status\":{\"title\":\"Reward Status\",\"type\":\"string\"},\"utid\":{\"title\":\"Utid - Unique Tango Card ID.\",\"type\":\"string\"}},\"required\":[\"accountIdentifier\",\"accountNumber\",\"amountCharged\",\"campaign\",\"createdAt\",\"customerIdentifier\",\"emailSubject\",\"etid\",\"message\",\"referenceOrderID\",\"rewardName\",\"status\",\"utid\"],\"type\":\"object\"},\"title\":\"Order elements for the current page\",\"type\":\"array\"},\"page\":{\"properties\":{\"elementsPerBlock\":{\"format\":\"int32\",\"title\":\"Total number of elements per page\",\"type\":\"integer\"},\"number\":{\"format\":\"int32\",\"title\":\"Current page number\",\"type\":\"integer\"},\"resultCount\":{\"format\":\"int32\",\"title\":\"Total number of elements in the current page\",\"type\":\"integer\"},\"totalCount\":{\"format\":\"int64\",\"title\":\"Total number of elements\",\"type\":\"integer\"}},\"required\":[\"elementsPerBlock\",\"number\",\"resultCount\",\"totalCount\"],\"title\":\"Page data for matching orders\",\"type\":\"object\"}},\"required\":[\"orders\",\"page\"],\"type\":\"object\"}}},\"description\":\"OK\"},\"400\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"errors\":{\"items\":{},\"type\":\"array\"},\"httpCode\":{\"format\":\"int32\",\"type\":\"integer\"},\"httpPhrase\":{\"type\":\"string\"},\"i18nKey\":{\"type\":\"string\"},\"message\":{\"description\":\"A 