          contract: {
            id: "GET /asyncOrders"
            json: "{\"operationId\":\"listAsyncOrders\",\"parameters\":[{\"description\":\"specify the account to be queried.\",\"in\":\"query\",\"name\":\"accountIdentifier\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the customer to be queried\",\"in\":\"query\",\"name\":\"customerIdentifier\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the external reference ID to be queried\",\"in\":\"query\",\"name\":\"externalRefID\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the starting date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"startDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the ending date or date time to be queried according to RFC 3339, i.e. \\\"2016-01-01\\\" or \\\"2016-01-01T00:00:00Z\\\". See https://www.ietf.org/rfc/rfc3339.txt\\n\",\"in\":\"query\",\"name\":\"endDate\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the number of maxResults per page.\",\"in\":\"query\",\"name\":\"maxResults\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the number of elements in a block.\",\"in\":\"query\",\"name\":\"elementsPerBlock\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the page number to return.\",\"in\":\"query\",\"name\":\"page\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the minimum face value of the reward to be queried.\",\"in\":\"query\",\"name\":\"minAmount\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the maximum face value of the reward to be queried.\",\"in\":\"query\",\"name\":\"maxAmount\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the currency code of the reward to be queried.\",\"in\":\"query\",\"name\":\"currencyCode\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the unique identifier of the reward to be queried.\",\"in\":\"query\",\"name\":\"utid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the unique identifier of the physical delivery template to be queried.\",\"in\":\"query\",\"name\":\"ptid\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the reward name of the reward to be queried.\",\"in\":\"query\",\"name\":\"rewardName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender's first name to be queried.\",\"in\":\"query\",\"name\":\"senderFirstName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender's last name to be queried.\",\"in\":\"query\",\"name\":\"senderLastName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the sender email address to be queried.\",\"in\":\"query\",\"name\":\"senderEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's email address to be queried.\",\"in\":\"query\",\"name\":\"recipientEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's mobile number to be queried.\",\"in\":\"query\",\"name\":\"recipientMobileNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's first name to be queried.\",\"in\":\"query\",\"name\":\"recipientFirstName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the recipient's last name to be queried.\",\"in\":\"query\",\"name\":\"recipientLastName\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"deprecated\":true,\"description\":\"specify if sendEmail is true or false to be queried.\",\"in\":\"query\",\"name\":\"sendEmail\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the delivery method to be queried.\",\"in\":\"query\",\"name\":\"deliveryMethod\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the order status to be queried.\",\"in\":\"query\",\"name\":\"orderStatus\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the line item status to be queried.\",\"in\":\"query\",\"name\":\"lineItemStatus\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the campaign to be queried.\",\"in\":\"query\",\"name\":\"campaign\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the notes to be queried.\",\"in\":\"query\",\"name\":\"notes\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the notes to be queried.\",\"in\":\"query\",\"name\":\"lineItemNotes\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"description\":\"specify the purchaseOrderNumber to be queried.\",\"in\":\"query\",\"name\":\"purchaseOrderNumber\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"prevCursor\",\"required\":false,\"schema\":{\"type\":\"string\"}},{\"in\":\"query\",\"name\":\"nextCursor\",\"required\":false,\"schema\":{\"type\":\"string\"}}],\"protocol\":\"http\",\"responses\":{\"200\":{\"content\":{\"application/json\":{\"schema\":{\"properties\":{\"maxResults\":{\"description\":\"Maximum number of results per page\",\"format\":\"int64\",\"type\":\"integer\"},\"nextCursor\":{\"description\":\"Cursor for the next page of results\",\"type\":\"string\"},\"nextPageAvailable\":{\"description\":\"Indicates if a next page is available\",\"type\":\"boolean\"},\"orders\":{\"items\":{\"properties\":{\"accountIdentifier\":{\"title\":\"Account Identifier\",\"type\":\"string\"},\"accountNumber\":{\"title\":\"Account Number\",\"type\":\"string\"},\"amountCharged\":{\"description\":\"Initial value and the total charged amount on the acco