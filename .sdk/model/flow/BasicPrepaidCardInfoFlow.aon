# BasicPrepaidCardInfoFlow

main: kit: flow: BasicPrepaidCardInfoFlow:
{
  entity: "prepaid_card_info",
  kind: "basic",
  name: "BasicPrepaidCardInfoFlow",
  step: [
    {
      input: {
        ref: "prepaid_card_info_ref01",
        srcdatavar: "prepaid_card_info_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "prepaid_card_info01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-prepaid_card_info_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicPrepaidCardInfoFlow"
}