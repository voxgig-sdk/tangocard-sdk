# BasicWebhookFlow

main: kit: flow: BasicWebhookFlow:
{
  entity: "webhook",
  kind: "basic",
  name: "BasicWebhookFlow",
  step: [
    {
      input: {
        ref: "webhook_ref01"
      }

      match: {
        webhook_id: "webhook01"
      }

      op: "create"
    }

    {
      input: {
        ref: "webhook_ref01",
        srcdatavar: "webhook_ref01_data",
        suffix: "_dt0"
      }

      match: {
        id: "webhook01"
      }

      op: "load",
      valid: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-webhook_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicWebhookFlow"
}