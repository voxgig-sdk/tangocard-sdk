# BasicCreditCardFlow

main: kit: flow: BasicCreditCardFlow:
{
  entity: "credit_card",
  kind: "basic",
  name: "BasicCreditCardFlow",
  step: [
    {
      i: {
        ref: "credit_card_ref01"
      }

      o: "create"
    }

    {
      i: {
        ref: "credit_card_ref01",
        srcdatavar: "credit_card_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "credit_card01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-credit_card_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicCreditCardFlow"
}