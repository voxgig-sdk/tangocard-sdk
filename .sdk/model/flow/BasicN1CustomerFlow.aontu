  name: "BasicN1CustomerFlow",
  step: [
    {
      i: {
        ref: "n1_customer_ref01",
        srcdatavar: "n1_customer_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "n1_customer01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-n1_customer_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicN1CustomerFlow"
}