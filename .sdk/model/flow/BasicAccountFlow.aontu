# BasicAccountFlow

main: kit: flow: BasicAccountFlow:
{
  entity: "account",
  kind: "basic",
  name: "BasicAccountFlow",
  step: [
    {
      d: {
        customer_identifier: "customerentifier01"
      }

      i: {
        ref: "account_ref01",
        srcdatavar: "account_ref01_data",
        suffix: "_up0",
        textfield: "accountIdentifier"
      }

      o: "update",
      s: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_ref01"
          }
        }
      ]
    }

    {
      i: {
        ref: "account_ref01",
        srcdatavar: "account_ref01_data",
        suffix: "_dt0"
      }

      m: {
        id: "account01"
      }

      o: "load",
      v: [
        {
          apply: "TextFieldMark",
          def: {
            mark: "Mark01-account_ref01"
          }
        }
      ]
    }
  ],
  "key$": "BasicAccountFlow"
}