# Guide

guide: {
  metrics: count: entity: 3
  metrics: count: path: 3
  metrics: count: method: 4

  entity: catalog: {
    path: "/catalogs": {
      op: list: method: *GET
      op: list: transform: res: *("`body.brands`")|top
    }
  }

  entity: customer: {
    path: "/customers": {
      op: list: method: *GET
    }
  }

  entity: order: {
    path: "/orders": {
      op: create: method: *POST
      op: list: method: *GET
    }
  }

}